\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Operating characteristics across monitoring frequencies ($\mitdelta = 0.5$, $N_{\max } = 200$ per arm, $n_{\mathrm {rep}} = 2{,}000$). Bias and RMSE refer to the naive MLE at the stopping time. Percent saved is relative to the fixed-sample maximum. This scenario is overpowered (power 0.996-1.000 throughout); see the properly powered companion table below.}}{15}{table.caption.7}\protected@file@percent }
\newlabel{tab:hf-table}{{4}{15}{Operating characteristics across monitoring frequencies ($\delta = 0.5$, $N_{\max } = 200$ per arm, $n_{\mathrm {rep}} = 2{,}000$). Bias and RMSE refer to the naive MLE at the stopping time. Percent saved is relative to the fixed-sample maximum. This scenario is overpowered (power 0.996-1.000 throughout); see the properly powered companion table below}{table.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Expected sample size and sample size savings as a function of K (number of planned analyses) under delta = 0.5, n-max = 200 (overpowered scenario). The curve flattens rapidly: relative to the fixed design, K = 20 captures about 96 percent of the ASN reduction achieved by fully sequential monitoring (52.8 over 55.0); relative to K = 3, K = 20 captures about 87 percent of the incremental reduction from K = 3 to fully sequential, that is, (52.8 minus 38.7) over (55.0 minus 38.7). See the properly powered companion scenario above for the same comparison outside the ceiling-power regime.}}{16}{figure.caption.9}\protected@file@percent }
\newlabel{fig:hf-asn-plot}{{3}{16}{Expected sample size and sample size savings as a function of K (number of planned analyses) under delta = 0.5, n-max = 200 (overpowered scenario). The curve flattens rapidly: relative to the fixed design, K = 20 captures about 96 percent of the ASN reduction achieved by fully sequential monitoring (52.8 over 55.0); relative to K = 3, K = 20 captures about 87 percent of the incremental reduction from K = 3 to fully sequential, that is, (52.8 minus 38.7) over (55.0 minus 38.7). See the properly powered companion scenario above for the same comparison outside the ceiling-power regime}{figure.caption.9}{}}
\citation{ref-emersonParameterEstimationFollowing1990}
\def\@LN@column{1}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Operating characteristics across monitoring frequencies at $\mitdelta = 0.5$, $N_{\max } = 85$ per arm (fixed design at approximately 90\% power). Compare with the overpowered table above: power now visibly declines with K (0.897 at K=3 to 0.891 at K=85), and the percent-saved curve is smaller in absolute terms at every K.}}{17}{table.caption.8}\protected@file@percent }
\newlabel{tab:hf-table-90pow}{{5}{17}{Operating characteristics across monitoring frequencies at $\delta = 0.5$, $N_{\max } = 85$ per arm (fixed design at approximately 90\% power). Compare with the overpowered table above: power now visibly declines with K (0.897 at K=3 to 0.891 at K=85), and the percent-saved curve is smaller in absolute terms at every K}{table.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {A.3}Bias Under High-Frequency Monitoring}{17}{subsection.A.3}\protected@file@percent }
\newlabel{bias-under-high-frequency-monitoring}{{A.3}{17}{Bias Under High-Frequency Monitoring}{subsection.A.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Naive MLE bias at the stopping time as a function of K. More frequent monitoring increases the conditional bias at stopping because the test statistic is more likely to cross the boundary at an extreme point. The bias remains small in absolute terms and tends to increase with K, within Monte Carlo noise (see MCSE(Bias) in the table above).}}{17}{figure.caption.10}\protected@file@percent }
\newlabel{fig:hf-bias-plot}{{4}{17}{Naive MLE bias at the stopping time as a function of K. More frequent monitoring increases the conditional bias at stopping because the test statistic is more likely to cross the boundary at an extreme point. The bias remains small in absolute terms and tends to increase with K, within Monte Carlo noise (see MCSE(Bias) in the table above)}{figure.caption.10}{}}
